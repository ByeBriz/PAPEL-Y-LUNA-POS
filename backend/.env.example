# Variables de entorno del Backend (Django + PostgreSQL)
# Copia este archivo como backend/.env para configurar tu conexión local o en Render

DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_AUTHORS_JSON=[]

# Opción 1: URL completa de conexión a PostgreSQL (usada en Render)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/papel_y_luna_pos

# Opción 2: Variables individuales de PostgreSQL
# POSTGRES_DB=papel_y_luna_pos
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=tu_password_aqui
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
